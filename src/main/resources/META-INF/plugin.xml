<idea-plugin>
    <id>com.patrikmeixner.canopy</id>
    <name>Canopy Workspace</name>
    <vendor url="https://github.com/patrik-meixner/canopy">Patrik Meixner</vendor>

    <description><![CDATA[
    <p>One view over every tree an agent works in.</p>

    <p>Canopy runs Claude Code sessions inside your JetBrains IDE and, when they are done, lets you
    review what they changed in one diff tree that spans the project, its submodules and every
    git worktree.</p>

    <p><b>Review</b></p>
    <ul>
        <li>Detail tab: one session's changes across every repository it wrote to, sectioned into
            uncommitted, committed, pushed and untracked</li>
        <li>Files open in the IDE's own diff viewer; content is read only when you open one</li>
        <li>Commit across all touched repositories at once, updating submodule pointers in the parent</li>
    </ul>

    <p><b>Worktrees and submodules</b></p>
    <ul>
        <li>Worktrees grouped under the repository that owns them, with the sessions that ran in each</li>
        <li>Submodules discovered from git, including their own worktrees</li>
        <li>Create a worktree in any repository, not just the project root</li>
        <li>Says why a leftover directory is orphaned instead of calling everything "unregistered"</li>
    </ul>

    <p><b>Sessions</b></p>
    <ul>
        <li>Blocked agents sort first: waiting for permission, waiting for you, working</li>
        <li>Works for sessions running outside the plugin too</li>
        <li>Cmd+Shift+O for the session palette, Cmd+Shift+J to jump to the next one waiting</li>
        <li>Parsed transcripts are remembered between restarts, so a gigabyte of history is read once</li>
    </ul>

    <p><b>Terminal</b></p>
    <ul>
        <li>Clickable links and Cmd+V image paste in session terminals</li>
        <li>A plain shell tab for running whichever agent you like</li>
    </ul>

    <p>Canopy is free, and stays free. If it saves you time, you can
    <a href="https://ko-fi.com/patrikmeixner"><img src="https://storage.ko-fi.com/cdn/logomarkLogo.png"
    width="16" height="16" alt="Ko-fi"> buy me a coffee</a>.</p>
    ]]></description>

    <change-notes><![CDATA[
    <p>First public release.</p>
    <p>Per-version notes for every release after this one are listed on
    <a href="https://github.com/patrik-meixner/canopy/releases">GitHub</a>.</p>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.canopy.toolwindow.RestoreOpenSessionsActivity"/>

        <toolWindow
            id="Canopy"
            anchor="left"
            order="last"
            icon="/icons/canopy.svg"
            factoryClass="com.canopy.toolwindow.ClaudeSessionsToolWindowFactory"
            canCloseContents="true"
        />

        <toolWindow
            id="Session"
            anchor="right"
            icon="/icons/context.svg"
            factoryClass="com.canopy.toolwindow.ClaudeContextToolWindowFactory"
            canCloseContents="false"
        />

        <virtualFileSystem
            implementationClass="com.canopy.editor.ClaudeSessionFileSystem"
            key="claude-session"
        />

        <fileEditorProvider
            implementation="com.canopy.editor.ClaudeSessionEditorProvider"
        />

        <editorTabTitleProvider
            implementation="com.canopy.editor.ClaudeSessionTabTitleProvider"
        />

        <fileIconProvider
            implementation="com.canopy.editor.ClaudeSessionIconProvider"
        />

        <!--
            Two groups, because a single displayType cannot serve both cases.
            Successes are transient confirmations; failures need the user to act, so they must
            not evaporate on a timer. This was a single group at NONE up to 0.7.30, which meant
            every notification the plugin raised — operation failures included — went only to
            the Event Log, a tool window that is hidden by default.
        -->
        <notificationGroup
            id="Canopy"
            displayType="BALLOON"
        />

        <notificationGroup
            id="Canopy Errors"
            displayType="STICKY_BALLOON"
        />

        <!--
            Ambient, not user-initiated: fires whenever a background session wants attention.
            Kept at NONE so un-muting operation feedback doesn't also start popping balloons
            nobody asked for — the tab indicator already carries this. It gets its own id so a
            user who *does* want the balloons can switch it on in
            Settings > Appearance & Behavior > Notifications.
        -->
        <notificationGroup
            id="Canopy Session Attention"
            displayType="BALLOON"
        />

        <applicationConfigurable
            parentId="tools"
            instance="com.canopy.settings.CanopySettingsConfigurable"
            id="com.canopy.settings.CanopySettingsConfigurable"
            displayName="Canopy"
        />
    </extensions>
    <actions>
        <group id="Canopy.Menu" text="Canopy" popup="true" icon="/icons/canopy.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="Canopy.ActivateCanopy" class="com.canopy.toolwindow.ActivateCanopyAction"
                    text="Sessions and Workspaces" description="Open the Canopy tool window"/>
            <action id="Canopy.ActivateSession" class="com.canopy.toolwindow.ActivateSessionAction"
                    text="Session Review" description="Open the review of the session on screen"/>
            <separator/>
            <action id="Canopy.SearchSessions" class="com.canopy.editor.SearchSessionsAction"/>
            <action id="Canopy.SessionPalette" class="com.canopy.editor.SessionPaletteAction">
                <keyboard-shortcut keymap="$default" first-keystroke="meta shift O"/>
            </action>
            <action id="Canopy.FocusWaitingSession" class="com.canopy.editor.FocusWaitingSessionAction">
                <add-to-group group-id="EditorTabsEntryPoint" anchor="first"/>
                <keyboard-shortcut keymap="$default" first-keystroke="meta shift J"/>
            </action>
            <action id="Canopy.NewShellTerminal" class="com.canopy.editor.NewShellTerminalAction">
                <add-to-group group-id="EditorTabsEntryPoint" anchor="first"/>
            </action>
        </group>
    </actions>

</idea-plugin>
