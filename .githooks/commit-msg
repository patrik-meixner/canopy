#!/bin/sh
# Conventional Commits: type(scope): subject
subject=$(sed -n '1{/^#/d;p;}' "$1")
[ -z "$subject" ] && exit 0
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|refactor|chore|docs|test|perf|build|ci)(\([a-z0-9/-]+\))?!?: .+'; then
  echo "commit-msg: the subject is not a Conventional Commit." >&2
  echo "  got:      $subject" >&2
  echo "  expected: type(scope): what the change makes true" >&2
  echo "  types:    feat fix refactor chore docs test perf build ci" >&2
  exit 1
fi

if printf '%s' "$subject" | grep -Eq '\.$'; then
  echo "commit-msg: the subject ends in a period." >&2
  exit 1
fi

if [ "${#subject}" -gt 72 ]; then
  echo "commit-msg: the subject is ${#subject} characters; keep it under 72." >&2
  exit 1
fi
